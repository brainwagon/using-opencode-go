#!/usr/bin/env python3
"""Show remaining opencode Go quota against the $12/5h, $30/week, $60/month caps."""
import sys, os, argparse, datetime
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from goquota import (WINDOWS, fetch, window_state, window_start, model_breakdown,
                     all_models, models_available, format_hours, format_when,
                     pricing_catalog, average_shape, cost_per_message, PROVIDER)

p = argparse.ArgumentParser(
    description="Remaining opencode Go quota, with optional usage breakdowns.")
p.add_argument("--models", action="store_true",
               help=f"break down {PROVIDER} spend, and paid spend off the plan")
p.add_argument("--all", action="store_true",
               help="list every model used, all providers, with estimated cost")
p.add_argument("--catalog", action="store_true",
               help="list the plan's paid models with pricing and relative cost")
def positive_days(s):
    try:
        n = float(s)
    except ValueError:
        raise argparse.ArgumentTypeError(f"not a number: {s!r}")
    if not 0 < n <= 3650:
        raise argparse.ArgumentTypeError(f"must be between 0 and 3650, got {s}")
    return n

p.add_argument("--days", type=positive_days, metavar="N",
               help="window for the breakdowns (default: the current billing month)")
args = p.parse_args()

try:
    usage = fetch()
except FileNotFoundError as e:
    sys.exit(f"go-usage: no opencode credentials at {e.filename}\n"
             f"  set GO_AUTH to your auth.json if opencode stores it elsewhere")
except Exception as e:
    sys.exit(f"go-usage: could not fetch usage: {e}")

now = datetime.datetime.now(datetime.timezone.utc)
print(f"opencode Go usage @ {now.astimezone():%Y-%m-%d %H:%M %Z}\n")
for key, (label, cap, _days) in WINDOWS.items():
    pct, used, left, reset, hours_left, elapsed = window_state(usage, key, now)
    burn = f"{pct/elapsed:.2f}x pace" if elapsed > 1 else "window just reset"
    print(f"{label:>7}: ${used:6.2f} used / ${cap:5.2f}  "
          f"-> ${left:6.2f} left  ({pct}%, {burn})")
    print(f"{'':>7}  resets {reset.astimezone():%a %d %b %H:%M %Z} "
          f"(in {format_hours(hours_left)})  status={usage[key]['status']}")
    if key == "monthly" and elapsed > 1:
        print(f"{'':>7}  budget to fully use: ${left/(hours_left/24):.2f}/day "
              f"for the remaining {hours_left/24:.1f} days")
    print()

if args.all or args.models or args.catalog:
    if args.days is not None:
        start =now - datetime.timedelta(days=args.days)
        period = f"last {args.days:g} days"
    else:
        start = window_start(usage, "monthly")
        period = "this billing month"

if args.catalog:
    try:
        available, prices = models_available(), pricing_catalog()
    except Exception as e:
        sys.exit(f"go-usage: could not load model pricing: {e}")
    try:
        shape = average_shape(start)
    except Exception:
        shape = None  # no readable local history; fall back to a generic shape
    if shape is None:
        # nothing local to calibrate against; price a plausible generic message
        shape = {"input": 2000, "output": 500, "cache_read": 20000, "messages": 0}
        basis = "a generic 2K input / 500 output / 20K cached message"
    else:
        basis = (f"{shape['input']:,.0f} input + {shape['output']:,.0f} output + "
                 f"{shape['cache_read']:,.0f} cached tokens\n  "
                 f"(mean of {shape['messages']:,} local messages, {period})")

    rows = []
    for mid in available:
        p_ = prices.get(mid)
        if not p_:
            continue
        rows.append({"id": mid, "cost": p_["cost"], "context": p_["context"],
                     "source": p_["provider"],
                     "per_msg": cost_per_message(p_["cost"], shape)})
    rows.sort(key=lambda x: x["per_msg"])
    if not rows:
        sys.exit("go-usage: no pricing found for any available model")

    _p, _u, left_m, _r, hours_m, _e = window_state(usage, "monthly", now)
    daily = left_m / (hours_m / 24) if hours_m > 0 else 0
    cheapest = rows[0]["per_msg"] or 1e-12

    print(f"Go plan models priced against your own message shape:\n  {basis}\n")
    print(f"  {'model':<32} {'in $/M':>7} {'out $/M':>8} {'cache $/M':>10} "
          f"{'est $/msg':>10} {'rel':>7} {'msgs/day':>9}")
    for x in rows:
        c = x["cost"]
        cache = c.get("cache_read", c.get("input", 0))
        per_day = int(daily / x["per_msg"]) if x["per_msg"] else 0
        label = x["id"] if x["source"] == PROVIDER else x["id"] + " *"
        print(f"  {label:<32} {c.get('input',0):>7.3f} {c.get('output',0):>8.3f} "
              f"{cache:>10.4f} {x['per_msg']:>10.4f} "
              f"{x['per_msg']/cheapest:>6.1f}x {per_day:>9,}")
    print(f"\n  msgs/day is what ${daily:.2f}/day buys -- the pace that would exactly "
          f"use\n  the ${left_m:.2f} of Go budget left before reset.")
    priced = {x["id"] for x in rows}
    missing = sorted(m for m in available if m not in priced)
    if missing:
        print(f"\n  no pricing in the registry for: {', '.join(missing)}")
    borrowed = sorted({x["source"] for x in rows if x["source"] != PROVIDER})
    if borrowed:
        print(f"\n  * priced from another vendor ({', '.join(borrowed)}) because the "
              f"registry\n    carries no {PROVIDER} entry -- treat those rows as "
              f"indicative only.")
    print(f"\n  Availability is live from the Go API; prices come from the models.dev\n"
          f"  registry's {PROVIDER} entry, which prices this plan specifically.")
    if not (args.all or args.models):
        sys.exit(0)
    print()

if args.all:
    try:
        rows = all_models(start)
    except Exception as e:
        sys.exit(f"go-usage: could not read local history: {e}")
    print(f"All models used, {period} "
          f"(since {format_when(start, now)}, local estimates)\n")
    if not rows:
        print("  nothing recorded locally in this window")
    else:
        print(f"  {'provider/model':<52} {'msgs':>6} {'cost':>9} {'$/msg':>8}")
        for r_ in rows:
            per = r_["cost"] / r_["messages"] if r_["messages"] else 0
            print(f"  {r_['name']:<52} {r_['messages']:>6} {r_['cost']:>9.4f} "
                  f"{per:>8.4f}")
        print(f"  {'':<52} {'-'*6} {'-'*9}")
        print(f"  {'total':<52} {sum(x['messages'] for x in rows):>6} "
              f"{sum(x['cost'] for x in rows):>9.4f}")
        free = [x for x in rows if not x["cost"]]
        if free:
            print(f"\n  {len(free)} of these cost nothing (local or free-tier models).")
    if not args.models:
        sys.exit(0)
    print()

if not args.models:
    sys.exit(0)

try:
    rows, others = model_breakdown(start)
except Exception as e:
    sys.exit(f"go-usage: could not read local history: {e}")

print(f"Per-model {PROVIDER} usage, {period} (local data since "
      f"{format_when(start, now)})\n")
if not rows:
    print(f"  no {PROVIDER} messages recorded locally in this window")
    sys.exit(0)

print(f"  {'model':<30} {'msgs':>6} {'cost':>9} {'$/msg':>8} {'share':>6} {'cached':>7}")
local_total = sum(r["cost"] for r in rows)
msgs = sum(r["messages"] for r in rows)
for r in rows:
    per = r["cost"] / r["messages"] if r["messages"] else 0
    share = 100 * r["cost"] / local_total if local_total else 0
    seen = r["input"] + r["cache_read"]
    cached = f"{100*r['cache_read']/seen:.0f}%" if seen else "-"
    print(f"  {r['model']:<30} {r['messages']:>6} {r['cost']:>9.4f} "
          f"{per:>8.4f} {share:>5.0f}% {cached:>7}")

_pct, server_used, _left, _r, _h, _e = window_state(usage, "monthly", now)
print(f"  {'':<30} {'-'*6} {'-'*9}")
print(f"  {'local total':<30} {msgs:>6} {local_total:>9.4f}")
# the server figure covers the whole billing month, so it only compares with a
# local total taken over that same window
if server_used and args.days is None:
    print(f"  {'server reports':<30} {'':>6} {server_used:>9.2f}"
          f"   (local accounts for {100*local_total/server_used:.0f}%)")
if not others:
    sys.exit(0)

# Paid spend outside the Go plan. Worth seeing next to unused Go budget, but only
# the models Go actually serves could have been moved, so mark which those are.
try:
    on_go = models_available()
except Exception:
    on_go = set()

# openrouter ids carry a vendor prefix (deepseek/deepseek-v4-flash); Go ids do not
_basename = lambda m: m.rsplit("/", 1)[-1]
other_total = sum(r["cost"] for r in others)
movable = sum(r["cost"] for r in others if _basename(r["model"]) in on_go)
print(f"\nPaid spend outside the Go plan, same window: ${other_total:.2f}")
print("(billed to those accounts, separately from the Go subscription)\n")
for r in others:
    mark = "same model on Go" if _basename(r["model"]) in on_go else "no Go equivalent"
    print(f"  {r['name']:<46} {r['messages']:>4} msg  {r['cost']:>8.4f}  {mark}")
if on_go:
    amt = f"${movable:.2f}" if movable >= 0.01 else f"${movable:.4f}"
    print(f"\n  {amt} of that used a model Go already serves, so it could have come"
          f"\n  out of the ${_left:.2f} of Go budget that expires unused instead.")
